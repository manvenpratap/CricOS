{
  "name": "cricket-platform",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && node --experimental-strip-types --test tests/**/*.test.ts",
    "test:migrations": "node --experimental-strip-types --test tests/migrations-and-seed.test.ts",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "dev": "pnpm --filter @cricket-platform/api dev",
    "start": "pnpm --filter @cricket-platform/api start"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pg-mem": "^3.0.14",
    "typescript": "^5.8.3"
  }
}
