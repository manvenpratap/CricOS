# CricOS Production Environment Configuration Template
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database & Connection Pooling
DATABASE_URL=postgresql://cricos_prod_user:SECURE_PASSWORD@postgres.internal:5432/cricos_production
DB_POOL_SIZE=25

# Cache & Distributed Locks
REDIS_URL=redis://default:REDIS_SECRET@redis.internal:6379

# Cryptographic Security (Minimum 32 characters, base64 or high-entropy hex string)
JWT_SECRET=production_cricos_jwt_secret_min_32_characters_hmac256_strong_key_sample

# Commercial Operations & Payments
PAYMENT_MODE=live
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=live_secret_sample_key_here
RAZORPAY_WEBHOOK_SECRET=webhook_secret_hmac_sample

# Domain & Platform URLs
APP_BASE_URL=https://cricos.app
CORS_ORIGINS=https://cricos.app,https://admin.cricos.app
