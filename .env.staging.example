# CricOS Staging Environment Configuration Template
NODE_ENV=staging
PORT=3000
HOST=0.0.0.0

# Database & Connection Pooling
DATABASE_URL=postgresql://cricos_staging_user:STAGING_PASSWORD@postgres.staging.internal:5432/cricos_staging
DB_POOL_SIZE=15

# Cache & Distributed Locks
REDIS_URL=redis://default:STAGING_REDIS@redis.staging.internal:6379

# Cryptographic Security
JWT_SECRET=staging_cricos_jwt_secret_min_32_characters_hmac256_strong_key_staging

# Commercial Operations & Payments
PAYMENT_MODE=sandbox
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=test_secret_sample_key_here
RAZORPAY_WEBHOOK_SECRET=webhook_secret_hmac_sample

# Domain & Platform URLs
APP_BASE_URL=https://staging.cricos.app
CORS_ORIGINS=https://staging.cricos.app
